<mj-section background-color="#F5F0EB" padding="32px 24px">
  <mj-column>
    <mj-divider border-color="#E6DED7" border-width="1px" padding="0 0 24px 0" />

    <mj-text
      align="center"
      color="#5E5A55"
      font-family="'Helvetica Neue', Arial, sans-serif"
      font-size="13px"
      line-height="20px"
    >
      Bei Fragen erreichst du uns unter
      <a href="mailto:{{replyTo}}" style="color: #688B68; text-decoration: underline;">{{replyTo}}</a>
    </mj-text>

    <mj-text
      align="center"
      color="#9A958F"
      font-family="'Helvetica Neue', Arial, sans-serif"
      font-size="11px"
      line-height="18px"
      padding="16px 0 0 0"
    >
      © {{year}} Tanzmoment · Alle Rechte vorbehalten<br />
      <a href="{{baseUrl}}/datenschutz" style="color: #9A958F;">Datenschutz</a> ·
      <a href="{{baseUrl}}/impressum" style="color: #9A958F;">Impressum</a>
    </mj-text>
  </mj-column>
</mj-section>
