<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#2E2A25" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#FDF8F3">
    {{> header}}

    <mj-section background-color="#FFFFFF" padding="40px 32px">
      <mj-column>
        <mj-text font-size="22px" font-family="Georgia, 'Times New Roman', serif" padding="0 0 8px 0">
          Hallo {{firstName}},
        </mj-text>

        <mj-text padding="0 0 24px 0">
          deine Buchung für <strong>{{courseName}}</strong> wurde storniert.
        </mj-text>

        <mj-section background-color="#FDF8F3" border-radius="8px" padding="24px">
          <mj-column>
            <mj-text font-size="13px" color="#5E5A55" padding="0 0 12px 0">
              STORNIERUNGSDETAILS
            </mj-text>
            <mj-text padding="4px 0">
              <strong>Kurs:</strong> {{courseName}}
            </mj-text>
            <mj-text padding="4px 0">
              <strong>Termin:</strong> {{formatDate sessionDate}}, {{formatTime sessionStart}} Uhr
            </mj-text>
            <mj-text padding="4px 0">
              <strong>Storniert am:</strong> {{formatDate cancelledAt}}
            </mj-text>
          </mj-column>
        </mj-section>

        {{#if refundAmount}}
        <mj-section background-color="#D1FAE5" border-radius="8px" padding="20px 24px">
          <mj-column>
            <mj-text color="#378A5C" font-weight="600" padding="0 0 4px 0">
              Erstattung
            </mj-text>
            <mj-text color="#2E2A25" padding="0">
              {{#eq refundType "full"}}
                Dir wird der volle Betrag von <strong>{{formatPrice refundAmount}}</strong> erstattet.
              {{/eq}}
              {{#eq refundType "partial"}}
                Dir werden <strong>{{formatPrice refundAmount}}</strong> ({{refundPercent}}%) erstattet.
              {{/eq}}
              Die Gutschrift erscheint innerhalb von 5–10 Werktagen auf deinem Konto.
            </mj-text>
          </mj-column>
        </mj-section>
        {{/if}}

        {{#eq refundType "none"}}
        <mj-section background-color="#FEF3C7" border-radius="8px" padding="20px 24px">
          <mj-column>
            <mj-text color="#B8860B" padding="0">
              Gemäß unserer Stornierungsrichtlinie ist leider keine Erstattung möglich,
              da die Stornierung weniger als {{policyHours}} Stunden vor Kursbeginn erfolgte.
            </mj-text>
          </mj-column>
        </mj-section>
        {{/eq}}

        <mj-text padding="24px 0 0 0" font-size="14px" color="#5E5A55">
          Du kannst dich jederzeit für einen anderen Termin anmelden.
        </mj-text>

        <mj-button
          background-color="#688B68"
          color="#FFFFFF"
          font-size="15px"
          font-weight="500"
          border-radius="8px"
          inner-padding="14px 32px"
          href="{{baseUrl}}/kurse"
          padding="24px 0 0 0"
        >
          Kurse entdecken
        </mj-button>
      </mj-column>
    </mj-section>

    {{> footer}}
  </mj-body>
</mjml>
