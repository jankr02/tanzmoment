<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#2E2A25" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#FDF8F3">
    {{> header}}

    <mj-section background-color="#FFFFFF" padding="40px 32px">
      <mj-column>
        <mj-text font-size="22px" font-family="Georgia, 'Times New Roman', serif" padding="0 0 8px 0">
          Gute Nachrichten, {{firstName}}!
        </mj-text>

        <mj-text padding="0 0 24px 0">
          Ein Platz im Kurs <strong>{{courseName}}</strong> ist für dich frei geworden!
        </mj-text>

        <mj-section background-color="#FEF3C7" border-radius="8px" padding="20px 24px">
          <mj-column>
            <mj-text color="#B8860B" font-weight="600" padding="0 0 4px 0">
              Bitte innerhalb von 30 Minuten bestätigen
            </mj-text>
            <mj-text color="#2E2A25" padding="0">
              Deine Reservierung läuft um <strong>{{formatTime expiresAt}} Uhr</strong> ab.
              Danach wird der Platz an die nächste Person auf der Warteliste weitergegeben.
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-section background-color="#FDF8F3" border-radius="8px" padding="24px">
          <mj-column>
            <mj-text padding="4px 0"><strong>Kurs:</strong> {{courseName}}</mj-text>
            <mj-text padding="4px 0"><strong>Termin:</strong> {{formatDate sessionDate}}, {{formatTime sessionStart}} Uhr</mj-text>
            <mj-text padding="4px 0"><strong>Ort:</strong> {{location}}</mj-text>
            {{#if priceInCents}}
            <mj-text padding="4px 0"><strong>Preis:</strong> {{formatPrice priceInCents}}</mj-text>
            {{/if}}
          </mj-column>
        </mj-section>

        <mj-button
          background-color="#688B68"
          color="#FFFFFF"
          font-size="16px"
          font-weight="600"
          border-radius="8px"
          inner-padding="16px 40px"
          href="{{baseUrl}}/buchung/bestaetigen/{{bookingId}}"
          padding="32px 0 8px 0"
        >
          Jetzt Platz sichern
        </mj-button>

        <mj-text font-size="13px" color="#5E5A55" align="center" padding="0">
          Du wirst zur Bezahlung weitergeleitet.
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer}}
  </mj-body>
</mjml>
