{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tanzmoment/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@tanzmoment/web/features/landing": [
        "libs/web/features/landing/src/index.ts"
      ],
      "@tanzmoment/web/features/courses": [
        "libs/web/features/courses/src/index.ts"
      ],
      "@tanzmoment/shared/services": ["libs/shared/services/src/index.ts"],
      "@tanzmoment/shared/types": ["libs/shared/types/src/index.ts"],
      "@tanzmoment/web/features/about": ["libs/web/features/about/src/index.ts"],
      "@tanzmoment/web/features/contact": ["libs/web/features/contact/src/index.ts"],
      "@tanzmoment/web/features/target-groups": ["libs/web/features/target-groups/src/index.ts"],
      "@tanzmoment/web/features/booking": ["libs/web/features/booking/src/index.ts"],
      "@tanzmoment/admin/feature-shell": ["libs/admin/feature-shell/src/index.ts"],
      "@tanzmoment/admin/feature-dashboard": ["libs/admin/feature-dashboard/src/index.ts"],
      "@tanzmoment/admin/data-access": ["libs/admin/data-access/src/index.ts"],
      "@tanzmoment/admin/feature-courses": ["libs/admin/feature-courses/src/index.ts"],
      "@tanzmoment/admin/feature-bookings": ["libs/admin/feature-bookings/src/index.ts"],
      "@tanzmoment/admin/feature-calendar": ["libs/admin/feature-calendar/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
