# Database
DATABASE_URL="postgresql://tanzmoment:dev_password@localhost:5432/tanzmoment_dev?schema=public"

# JWT – generate a unique high-entropy secret: openssl rand -base64 48
# The app refuses to start with this placeholder outside of tests.
JWT_SECRET="CHANGE_ME_run_openssl_rand_base64_48"
JWT_EXPIRES_IN="7d"

# Stripe – get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email – SMTP (use Ethereal for dev: https://ethereal.email)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tanzmoment <noreply@tanzmoment.de>"
SMTP_REPLY_TO="kontakt@tanzmoment.de"

# Empfänger der Kontaktformular-Mails (Studio-Postfach). Default: SMTP_REPLY_TO
CONTACT_RECIPIENT_EMAIL=""

# Set to "false" to disable email sending in tests
EMAIL_ENABLED=true

# App URL used in email links
APP_URL="http://localhost:4200"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# App Config
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:4200"
