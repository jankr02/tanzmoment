# =============================================================================
# Production environment for the soft-launch (Hetzner + Docker + Cloudflare).
#
# Copy to `.env.prod`, fill in the real values, then lock it down:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# `.env.prod` is gitignored and must NEVER be committed or baked into an image.
#
# Bring the stack up (the file is used for BOTH compose interpolation and the
# containers' environment):
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# =============================================================================

NODE_ENV=production

# --- Database -----------------------------------------------------------------
# compose derives the api's DATABASE_URL from these three (host = postgres
# service), so they cannot drift. Do NOT also set DATABASE_URL here.
# POSTGRES_PASSWORD is interpolated into DATABASE_URL unencoded, so it MUST be
# URL-safe (no / @ : # ? % + ...). Generate a hex password: openssl rand -hex 32
POSTGRES_USER=tanzmoment
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_hex_32
POSTGRES_DB=tanzmoment

# --- Auth / JWT ---------------------------------------------------------------
# Generate a fresh, unique secret (the app refuses to boot with a placeholder):
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL=30d

# --- Auth cookies -------------------------------------------------------------
# Same-site deployment (SPA + API on one domain). COOKIE_SECURE empty => derived
# from NODE_ENV (true in production); users always reach the site over HTTPS at
# the Cloudflare edge, so Secure cookies are correct.
COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=

# --- Reverse proxy ------------------------------------------------------------
# Trusted proxy hop count so rate limiting sees the real client IP from
# X-Forwarded-For (cloudflared + Caddy in front of the API). VERIFY after deploy
# that logs show real client IPs, not the proxy IP, and adjust if needed.
TRUST_PROXY=2

# --- Public URLs --------------------------------------------------------------
# BOTH must be the exact soft-launch domain (https, no trailing slash). They feed
# CORS and every email/redirect link; a wrong value silently points at localhost.
FRONTEND_URL=https://CHANGE_ME.example.com
APP_URL=https://CHANGE_ME.example.com

# --- Redis --------------------------------------------------------------------
# Host/port are injected by compose (redis:6379); nothing to set here.

# --- Stripe (TEST keys during soft-launch) ------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
# From the Stripe webhook endpoint pointing at https://<domain>/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=CHANGE_ME.smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=Tanzmoment <noreply@CHANGE_ME.example.com>
SMTP_REPLY_TO=kontakt@CHANGE_ME.example.com
CONTACT_RECIPIENT_EMAIL=studio@CHANGE_ME.example.com
EMAIL_ENABLED=true

# --- First-run provisioning (idempotent bootstrap) ----------------------------
# Set RUN_BOOTSTRAP=true for the first deploy to create the admin + Daniela's
# instructor profile + a default location + the default cancellation policy.
# Idempotent and non-destructive; safe to leave enabled. If enabled, ADMIN_EMAIL
# and ADMIN_PASSWORD are required or the container aborts on start.
RUN_BOOTSTRAP=true
ADMIN_EMAIL=daniela@CHANGE_ME.example.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_FIRST_NAME=Daniela
ADMIN_LAST_NAME=Tanzmoment
# Placeholder location; Daniela renames/edits it in the admin UI afterwards.
LOCATION_NAME=Tanzmoment Studio
LOCATION_ADDRESS=

# --- Cloudflare tunnel (enable with `--profile tunnel`) -----------------------
TUNNEL_TOKEN=
